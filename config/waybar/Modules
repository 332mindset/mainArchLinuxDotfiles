{
  "clock": {
    "interval": 1,
    "format": "{:%H:%M}",
    "format-alt": " {:%H:%M   %d.%m.%Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "custom/separator#blank": {
    "format": " ",
    "tooltip": false
  },
  "network": {
    "format-ethernet": "󰌘",
    "format-wifi": "󰤨",
    "format-disconnected": "󰌙",
    "tooltip-format": "{ifname}: {ipaddr}\n↑ {bandwidthUpBits} ↓ {bandwidthDownBits}"
  },
  "group/audio": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "pulseaudio",
      "transition-left-to-right": true
    },
    "modules": [
      "pulseaudio",
      "pulseaudio#microphone"
    ]
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol -t 3",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip-format": "{desc} | {volume}%"
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "pavucontrol -t 4",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
    "tooltip-format": "{source_desc} | {source_volume}%"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 4
  },
  "cpu": {
    "format": "{usage}% 󰍛",
    "interval": 2,
    "tooltip": true
  },
  "memory": {
    "format": "{used:0.1f}G 󰾆",
    "interval": 10,
    "tooltip-format": "{used:0.1f} / {total:0.1f} GB"
  },
  "disk": {
    "format": "{percentage_used}% 󰋊",
    "path": "/",
    "interval": 30,
    "tooltip-format": "{used} / {total}"
  },
  "group/desktop": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "desktop-detail",
      "transition-left-to-right": true
    },
    "modules": [
      "cpu",
      "memory",
      "disk"
    ]
  },
  "hyprland/workspaces#letters": {
    "disable-scroll": true,
    "show-special": false,
    "all-outputs": false,
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "1": "A",
      "2": "B",
      "3": "C",
      "4": "D",
      "5": "E",
      "6": "F",
      "7": "G",
      "8": "H",
      "9": "I",
      "default": "·"
    },
    "persistent-workspaces": {
      "*": 6
    }
  },
  "custom/menu": {
    "format": "",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 24,
    "separate-outputs": true,
    "fallback": "~empty",
    "rewrite": {
      "^$": "~empty"
    }
  },
  "custom/arrow-right": {
    "format": "󰁙",
    "tooltip": false
  },
  "group/info": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/arrow-right",
      "cpu",
      "memory",
      "disk"
    ]
  },
  "group/demo": {
    "orientation": "inherit",
    "modules": [
      "tray",
      "pulseaudio",
      "hyprland/language",
      "idle_inhibitor"
    ]
  },
  "hyprland/language": {
    "format": "{}",
    "format-en": "EN",
    "format-ru": "RU",
    "tooltip-format": "{long}",
    "on-click": "hyprctl switchxkblayout current next"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "tooltip-format-activated": "Экран не гаснет",
    "tooltip-format-deactivated": "Обычный режим простоя"
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "dynamic-order": ["artist", "title"],
    "dynamic-separator": " — ",
    "max-length": 42,
    "player-icons": {
      "default": "",
      "spotify": "",
      "firefox": ""
    },
    "status-icons": {
      "paused": "󰐎"
    },
    "tooltip-format": "{dynamic}"
  },
  "custom/notifications": {
    "format": "{icon}",
    "return-type": "json",
    "exec-if": "command -v swaync-client",
    "exec": "swaync-client -swb",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  },
  "group/hub": {
    "orientation": "inherit",
    "modules": [
      "custom/notifications",
      "clock"
    ]
  },
  "custom/power": {
    "format": "⏻",
    "tooltip-format": "Power menu",
    "on-click": "~/.config/hypr/scripts/power_menu.py",
    "on-click-right": "~/.config/hypr/scripts/power_menu.py"
  },
  "custom/mute": {
    "exec": "~/.config/hypr/scripts/mute-status.py",
    "return-type": "json",
    "interval": 1,
    "on-click": "~/.config/hypr/scripts/mute-status.py toggle",
    "tooltip": true
  }
}
