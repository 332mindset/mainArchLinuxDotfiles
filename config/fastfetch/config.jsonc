{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch_small",
    "color": { "1": "#b8b8b8", "2": "#e2e2e2" },
    "padding": { "top": 0, "left": 1, "right": 4 }
  },
  "general": {
    "detectVersion": false
  },
  "display": {
    "brightColor": false,
    "separator": "  ",
    "color": {
      "keys": "#919191",
      "title": "#e2e2e2",
      "output": "#d4d4d4",
      "separator": "#555555"
    }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "separator", "string": "─", "outputColor": "#555555" },
    { "type": "os", "key": "os", "format": "{pretty-name}" },
    { "type": "kernel", "key": "kernel", "format": "{release}" },
    { "type": "wm", "key": "desktop", "format": "{pretty-name}" },
    { "type": "memory", "key": "ram", "format": "{used} / {total}" },
    { "type": "uptime", "key": "uptime", "format": "{formatted}" }
  ]
}
