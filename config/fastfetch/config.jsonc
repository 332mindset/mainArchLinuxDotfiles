{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "@HOME@/.config/fastfetch/japanese-ascii.txt",
    "color": {
      "1": "#c6c6c6",
      "2": "#a4a4a4"
    },
    "padding": {
      "top": 0,
      "left": 0,
      "right": 4
    }
  },
  "general": {
    "detectVersion": false
  },
  "display": {
    "brightColor": false,
    "separator": "  ",
    "color": {
      "keys": "#c6c6c6",
      "title": "#ebebeb",
      "output": "#ebebeb",
      "separator": "#7c7c7c"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "╭──────────╮",
      "outputColor": "#c6c6c6"
    },
    {
      "type": "title",
      "key": "│  user   │",
      "keyColor": "#a4a4a4",
      "format": "{user-name}"
    },
    {
      "type": "uptime",
      "key": "│ 󰥔 uptime │",
      "keyColor": "#c6c6c6",
      "format": "{formatted}"
    },
    {
      "type": "os",
      "key": "│  distro │",
      "keyColor": "#c6c6c6"
    },
    {
      "type": "kernel",
      "key": "│  kernel │",
      "keyColor": "#c6c6c6",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "│  wm     │",
      "keyColor": "#c6c6c6"
    },
    {
      "type": "terminal",
      "key": "│  term   │",
      "keyColor": "#a4a4a4"
    },
    {
      "type": "shell",
      "key": "│  shell  │",
      "keyColor": "#a4a4a4"
    },
    {
      "type": "packages",
      "key": "│ 󰏖 pkgs   │",
      "keyColor": "#c6c6c6"
    },
    {
      "type": "cpu",
      "key": "│  cpu    │",
      "keyColor": "#c6c6c6"
    },
    {
      "type": "gpu",
      "key": "│ 󰢮 gpu    │",
      "keyColor": "#c6c6c6"
    },
    {
      "type": "disk",
      "key": "│ 󰋊 disk   │",
      "keyColor": "#c6c6c6",
      "folders": "/"
    },
    {
      "type": "memory",
      "key": "│  memory │",
      "keyColor": "#c6c6c6",
      "format": "{used} / {total}"
    },
    {
      "type": "terminalfont",
      "key": "│  font   │",
      "keyColor": "#c6c6c6"
    },
    {
      "type": "custom",
      "format": "├──────────┤",
      "outputColor": "#c6c6c6"
    },
    {
      "type": "colors",
      "key": "│ 󰏘 colors │",
      "keyColor": "#c6c6c6",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "╰──────────╯",
      "outputColor": "#c6c6c6"
    }
  ]
}
