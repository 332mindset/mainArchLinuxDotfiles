{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // A random Pokémon from krabby; the plain Arch logo until krabby is installed.
    "type": "command-raw",
    "source": "command -v krabby >/dev/null && krabby random --no-title || sed 's/\\$1//' ~/.config/fastfetch/arch.txt",
    "padding": {
      "top": 0,
      "left": 2,
      "right": 4
    }
  },
  "general": {
    "detectVersion": false
  },
  "display": {
    "brightColor": false,
    "separator": "  ",
    "key": {
      "width": 8
    },
    "color": {
      "keys": "#89b4fa",
      "title": "#cba6f7",
      "output": "#e2e2e2",
      "separator": "#585b70"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "os",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "shell",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "term",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": "pkgs"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "memory",
      "key": "memory",
      "format": "{used} / {total}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
