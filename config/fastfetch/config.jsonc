{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "@HOME@/.config/fastfetch/arch.txt",
    "color": {
      "1": "#e6e6e6"
    },
    "padding": {
      "top": 0,
      "left": 2,
      "right": 4
    }
  },
  "general": {
    "detectVersion": false
  },
  "display": {
    "brightColor": false,
    "separator": "  ",
    "key": {
      "width": 8
    },
    "color": {
      "keys": "#808080",
      "title": "#e6e6e6",
      "output": "#e6e6e6",
      "separator": "#4d4d4d"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "os",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "shell",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "term",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": "pkgs"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "memory",
      "key": "memory",
      "format": "{used} / {total}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
