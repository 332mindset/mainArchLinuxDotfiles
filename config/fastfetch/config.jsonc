{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "@HOME@/.config/fastfetch/logos/4.png",
    "width": 34,
    "height": 17,
    "preserveAspectRatio": true,
    "padding": {
      "top": 0,
      "left": 1,
      "right": 3
    }
  },
  "general": {
    "detectVersion": false
  },
  "display": {
    "brightColor": false,
    "separator": "  ",
    "color": {
      "keys": "#cba6f7",
      "title": "#cdd6f4",
      "output": "#cdd6f4",
      "separator": "#6c7086"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "╭──────────╮",
      "outputColor": "#cba6f7"
    },
    {
      "type": "title",
      "key": "│  user   │",
      "keyColor": "#f5c2e7",
      "format": "{user-name}"
    },
    {
      "type": "uptime",
      "key": "│ 󰥔 uptime │",
      "keyColor": "#cba6f7",
      "format": "{formatted}"
    },
    {
      "type": "os",
      "key": "│  distro │",
      "keyColor": "#cba6f7"
    },
    {
      "type": "kernel",
      "key": "│  kernel │",
      "keyColor": "#cba6f7",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "│  wm     │",
      "keyColor": "#cba6f7"
    },
    {
      "type": "terminal",
      "key": "│  term   │",
      "keyColor": "#f5c2e7"
    },
    {
      "type": "shell",
      "key": "│  shell  │",
      "keyColor": "#f5c2e7"
    },
    {
      "type": "packages",
      "key": "│ 󰏖 pkgs   │",
      "keyColor": "#cba6f7"
    },
    {
      "type": "cpu",
      "key": "│  cpu    │",
      "keyColor": "#cba6f7"
    },
    {
      "type": "gpu",
      "key": "│ 󰢮 gpu    │",
      "keyColor": "#cba6f7"
    },
    {
      "type": "disk",
      "key": "│ 󰋊 disk   │",
      "keyColor": "#cba6f7",
      "folders": "/"
    },
    {
      "type": "memory",
      "key": "│  memory │",
      "keyColor": "#cba6f7",
      "format": "{used} / {total}"
    },
    {
      "type": "terminalfont",
      "key": "│  font   │",
      "keyColor": "#cba6f7"
    },
    {
      "type": "custom",
      "format": "├──────────┤",
      "outputColor": "#cba6f7"
    },
    {
      "type": "colors",
      "key": "│ 󰏘 colors │",
      "keyColor": "#cba6f7",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "╰──────────╯",
      "outputColor": "#cba6f7"
    }
  ]
}
