/* Generated by matugen from the wallpaper — edit ~/.config/matugen/templates/rofi.rasi */
* {
    background:                  {{colors.surface.default.hex}}F2;
    background-alt:              {{colors.surface_container_high.default.hex}}FF;
    foreground:                  {{colors.on_surface.default.hex}}FF;
    selected:                    {{colors.primary.default.hex}}FF;
    active:                      {{colors.tertiary.default.hex}}FF;
    urgent:                      {{colors.on_surface.default.hex}}FF;
}
