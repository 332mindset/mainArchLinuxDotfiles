# Catppuccin Mocha spectrum matching Kitty, Hyprland and Waybar.
# r: reload config; arrows: adjust sensitivity / number of bars; q: quit.

[general]
live-config = 1
framerate = 60
autosens = 1
sensitivity = 100
bars = 0
bar_width = 2
bar_spacing = 1
center_align = 1
max_height = 90
lower_cutoff_freq = 50
higher_cutoff_freq = 10000
sleep_timer = 10

[input]
# Keep automatic backend selection and monitor the default audio output.
source = auto

[output]
method = noncurses
orientation = bottom
channels = stereo
reverse = 0
xaxis = none
show_idle_bar_heads = 0
waveform = 0

[color]
# Leave background unset to preserve Foot's background and transparency.
foreground = '#cba6f7'
gradient = 1
gradient_color_1 = '#89b4fa'
gradient_color_2 = '#8fb0f9'
gradient_color_3 = '#a2adf8'
gradient_color_4 = '#b4befe'
gradient_color_5 = '#cba6f7'
gradient_color_6 = '#dbb0f2'
gradient_color_7 = '#f5c2e7'
gradient_color_8 = '#f2cdcd'
horizontal_gradient = 0

[smoothing]
noise_reduction = 78
monstercat = 0
waves = 0
