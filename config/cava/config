# Monochrome spectrum matching Foot, Hyprland and Waybar.
# r: reload config; arrows: adjust sensitivity / number of bars; q: quit.

[general]
live-config = 1
framerate = 60
autosens = 1
sensitivity = 100
bars = 0
bar_width = 2
bar_spacing = 1
center_align = 1
max_height = 90
lower_cutoff_freq = 50
higher_cutoff_freq = 10000
sleep_timer = 10

[input]
# Keep automatic backend selection and monitor the default audio output.
source = auto

[output]
method = noncurses
orientation = bottom
channels = stereo
reverse = 0
xaxis = none
show_idle_bar_heads = 0
waveform = 0

[color]
# Leave background unset to preserve Foot's background and transparency.
foreground = '#e2e2e2'
gradient = 1
gradient_color_1 = '#606060'
gradient_color_2 = '#7c7c7c'
gradient_color_3 = '#919191'
gradient_color_4 = '#a4a4a4'
gradient_color_5 = '#b8b8b8'
gradient_color_6 = '#c6c6c6'
gradient_color_7 = '#d4d4d4'
gradient_color_8 = '#ebebeb'
horizontal_gradient = 0

[smoothing]
noise_reduction = 78
monstercat = 0
waves = 0
