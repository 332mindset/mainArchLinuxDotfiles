configuration {
    modi: "drun,configs:@HOME@/.config/rofi/scripts/config-modules.py,filebrowser";
    show-icons: true;
    icon-theme: "breeze-dark";
    application-fallback-icon: "application-x-executable";
    terminal: "@HOME@/.local/bin/open-terminal";
    drun-display-format: "{name}";
}
@theme "themes/adi-type1-style5.rasi"
