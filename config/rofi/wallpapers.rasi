@theme "themes/adi-type1-style5.rasi"

window { width: 80%; }
mainbox { spacing: 16px; }
mode-switcher { enabled: false; }
entry { placeholder: "Search wallpapers…"; }
textbox { horizontal-align: 0.5; }

/* One horizontal strip of portrait cards; thumbnails come pre-cropped and rounded. */
listview {
    layout: vertical;
    flow: horizontal;
    columns: 7;
    lines: 1;
    fixed-columns: true;
    spacing: 14px;
    scrollbar: false;
    fixed-height: true;
}
element {
    orientation: vertical;
    children: [ element-icon, element-text ];
    spacing: 8px;
    padding: 6px;
    border-radius: 16px;
}
element normal.normal, element alternate.normal,
element normal.active, element alternate.active {
    background-color: transparent;
    text-color: @foreground-colour;
}
/* The wallpaper currently on the desktop gets a green label. */
element normal.active, element alternate.active { text-color: @active-background; }
element selected.normal, element selected.active {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
}
element-icon { size: 320px; horizontal-align: 0.5; expand: false; }
element-text {
    horizontal-align: 0.5;
    font: "JetBrainsMono Nerd Font 9";
}
