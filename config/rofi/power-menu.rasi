@theme "themes/adi-type1-style5.rasi"

window { location: center; anchor: center; width: 560px; height: 0; }
mode-switcher { enabled: false; }
entry { placeholder: "Choose an action…"; }
textbox { horizontal-align: 0.5; }

listview {
    lines: 2;
    columns: 3;
    flow: horizontal;
    layout: vertical;
    fixed-columns: true;
    fixed-height: true;
    dynamic: false;
    scrollbar: false;
    spacing: 10px;
}
element {
    orientation: vertical;
    children: [ element-icon, element-text ];
    spacing: 10px;
    padding: 16px 8px;
    border-radius: 10px;
}
element normal.normal, element alternate.normal {
    background-color: @alternate-background;
}
element-icon { size: 64px; horizontal-align: 0.5; expand: false; }
element-text { horizontal-align: 0.5; }
/* The base theme paints selected and idle tiles the same; make the keyboard choice visible. */
element { border: 2px solid; border-color: transparent; }
element selected.normal, element selected.active, element selected.urgent {
    background-color: #e2e2e247;
    border-color: @selected;
}
