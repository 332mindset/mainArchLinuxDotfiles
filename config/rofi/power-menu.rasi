@theme "themes/simple-tokyonight.rasi"

* {
    font: "JetBrainsMono Nerd Font 11";
    bg0: #181818;
    bg1: #242424;
    bg2: #383838;
    bg3: #b8b8b8;
    fg0: #e2e2e2;
    fg2: #919191;
    accent: #dedede;
}
window {
    width: 680px;
    background-color: @bg0;
    border: 2px;
    border-color: @bg3;
    border-radius: 22px;
    padding: 20px;
}
mainbox { children: [ inputbar, message, listview ]; spacing: 14px; }
inputbar {
    children: [ prompt, entry ];
    background-color: @bg1;
    border-radius: 12px;
    spacing: 16px;
    padding: 14px;
}
prompt { text-color: @accent; }
entry { placeholder: "Choose an action…"; placeholder-color: @fg2; }
message { background-color: transparent; }
textbox { padding: 0; background-color: transparent; text-color: @fg2; font: "JetBrainsMono Nerd Font 10"; }
listview {
    lines: 2;
    columns: 3;
    flow: horizontal;
    layout: vertical;
    fixed-columns: true;
    fixed-height: true;
    dynamic: false;
    scrollbar: false;
    spacing: 12px;
    padding: 0;
}
element {
    orientation: vertical;
    children: [ element-icon, element-text ];
    spacing: 14px;
    padding: 18px 8px;
    border: 2px;
    border-radius: 16px;
    border-color: @bg1;
    background-color: @bg1;
    text-color: @fg0;
}
element normal normal, element alternate normal {
    background-color: @bg1;
    border-color: @bg1;
    text-color: @fg0;
}
element selected normal {
    background-color: @bg2;
    border-color: @bg3;
    text-color: @fg0;
}
element-icon { size: 76px; horizontal-align: 0.5; vertical-align: 0.5; expand: false; }
element-text { horizontal-align: 0.5; vertical-align: 0.5; text-color: inherit; }
