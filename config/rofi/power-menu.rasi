@theme "themes/adi-type1-style5.rasi"

window { width: 560px; }
mode-switcher { enabled: false; }
entry { placeholder: "Choose an action…"; }
textbox { horizontal-align: 0.5; }

listview {
    lines: 2;
    columns: 3;
    flow: horizontal;
    layout: vertical;
    fixed-columns: true;
    fixed-height: true;
    dynamic: false;
    scrollbar: false;
    spacing: 10px;
}
element {
    orientation: vertical;
    children: [ element-icon, element-text ];
    spacing: 10px;
    padding: 16px 8px;
    border-radius: 10px;
}
element normal.normal, element alternate.normal {
    background-color: @alternate-background;
}
element-icon { size: 64px; horizontal-align: 0.5; expand: false; }
element-text { horizontal-align: 0.5; }
