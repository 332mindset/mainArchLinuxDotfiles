/* Clipboard picker in the launcher's pill-grid style: one column, wider pills for long entries. */
@theme "themes/pill-grid.rasi"

window   { width: 760px; }
mainbox  { children: [ inputbar, message, listview ]; }
entry    { placeholder: "Search clipboard..."; }
listview { columns: 1; lines: 8; }
element  { padding: 10px 14px; children: [ element-text ]; }
