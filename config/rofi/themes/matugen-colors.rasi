/* Static colour palette for Rofi; edit this file directly. */
* {
    background:                  #131313F2;
    background-alt:              #2a2a2aFF;
    foreground:                  #e2e2e2FF;
    selected:                    #ffffffFF;
    active:                      #e2e2e2FF;
    urgent:                      #e2e2e2FF;
    /* Glass look shared with Waybar: translucent black, blurred by Hyprland. */
    glass:                       #00000099;
    glass-border:                #e2e2e233;
    tile:                        #e2e2e21F;
    dim:                         #e2e2e280;
}
