/* Sidebar layout inspired by adi1090x/rofi, type-1 style-9.
 * https://github.com/adi1090x/rofi/blob/master/files/launchers/type-1/style-9.rasi
 * Local adaptation: app icons, configuration modules and a neutral palette.
 */
* {
    font: "Adwaita Sans 11";
    background: #202020;
    background-alt: #303030;
    foreground: #e2e2e2;
    muted: #919191;
    selected: #c8c8c8;
    border-color: @selected;
    background-color: transparent;
    text-color: @foreground;
    margin: 0;
    padding: 0;
    spacing: 0;
}
window {
    location: center;
    anchor: center;
    width: 700px;
    fullscreen: false;
    border: 0;
    border-radius: 10px;
    background-color: @background;
}
mainbox {
    spacing: 10px;
    padding: 20px;
    children: [ inputbar, message, custombox ];
}
inputbar {
    spacing: 10px;
    padding: 8px 12px;
    border-radius: 8px;
    background-color: @background-alt;
    children: [ icon-search, entry ];
}
icon-search {
    filename: "system-search";
    size: 20px;
    expand: false;
    vertical-align: 0.5;
}
entry {
    padding: 5px 0;
    placeholder: "Search…";
    placeholder-color: @muted;
    cursor: text;
}
custombox {
    orientation: horizontal;
    children: [ mode-switcher, listview ];
}
mode-switcher {
    enabled: true;
    expand: false;
    width: 180px;
    orientation: vertical;
    border-radius: 8px 0 0 8px;
    background-color: @background-alt;
}
button {
    markup: true;
    padding: 0 16px;
    border: 0 2px 0 0;
    border-color: @selected;
    text-color: @foreground;
    vertical-align: 0.5;
    horizontal-align: 0;
    cursor: pointer;
}
button selected {
    border: 2px 0 2px 2px;
    border-radius: 8px 0 0 8px;
    background-color: @background;
    text-color: @selected;
}
listview {
    columns: 1;
    lines: 6;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    fixed-height: true;
    fixed-columns: true;
    spacing: 5px;
    padding: 10px;
    border: 2px 2px 2px 0;
    border-radius: 0 8px 8px 0;
    border-color: @selected;
}
element {
    spacing: 10px;
    padding: 10px;
    border-radius: 8px;
    orientation: horizontal;
    children: [ element-icon, element-text ];
    cursor: pointer;
}
element normal normal, element alternate normal,
element normal active, element alternate active,
element normal urgent, element alternate urgent {
    background-color: @background;
    text-color: @foreground;
}
element selected normal, element selected active, element selected urgent {
    background-color: @selected;
    text-color: @background;
}
element-icon { size: 24px; vertical-align: 0.5; cursor: inherit; }
element-text {
    text-color: inherit;
    vertical-align: 0.5;
    horizontal-align: 0;
    cursor: inherit;
}
message { background-color: transparent; }
textbox {
    padding: 12px;
    border-radius: 8px;
    background-color: @background-alt;
    text-color: @foreground;
}
error-message { padding: 10px; border: 2px; border-radius: 8px; background-color: @background; }
